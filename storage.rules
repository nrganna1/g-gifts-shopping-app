rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStoreOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "nrganna1@gmail.com";
    }

    // Public catalog images; only the single store owner may upload, replace or delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isStoreOwner();
    }

    // Customer design uploads are limited to image files under 10 MB.
    // Download/read access is restricted to the store owner to protect customer photos.
    match /custom_designs/{allPaths=**} {
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read, update, delete: if isStoreOwner();
    }
  }
}
